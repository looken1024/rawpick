<view class="container">
  <view class="header">
    <text class="title">图片审核</text>
    <text class="count">待审核：{{images.length}}张</text>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="empty-tip" wx:elif="{{images.length === 0}}">暂无待审核图片</view>

  <view class="image-list">
    <view class="image-item" wx:for="{{images}}" wx:key="_id">
      <view class="image-wrapper" bindtap="previewImage" data-url="{{item.originalFileID}}">
        <image class="image-thumb" src="{{item.thumbnailFileID}}" mode="aspectFill" />
      </view>
      <view class="image-info">
        <text class="image-title">{{item.title}}</text>
        <text class="image-meta">{{item.width}}×{{item.height}} | {{item.category}}</text>
      </view>
      <view class="action-btns">
        <view class="btn approve-btn" bindtap="onApprove" data-id="{{item._id}}">通过</view>
        <view class="btn reject-btn" bindtap="onReject" data-id="{{item._id}}">拒绝</view>
      </view>
    </view>
  </view>
</view>

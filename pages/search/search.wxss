page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding: 0 20rpx 20rpx;
  box-sizing: border-box;
}

/* 顶部搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #fff;
  margin: 0 -20rpx 20rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 20rpx;
  height: 64rpx;
  margin-left: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 36rpx;
  color: #999;
  flex-shrink: 0;
}

/* 分类 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.refresh-btn {
  display: flex;
  align-items: center;
}

.refresh-icon {
  font-size: 28rpx;
  color: #1296db;
  margin-right: 8rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: #1296db;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

/* 热门搜索 */
.hot-list {
  display: flex;
  flex-direction: column;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-index {
  width: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.hot-index.top {
  color: #ff4d4f;
  font-weight: bold;
}

.hot-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 搜索历史 */
.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 14rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.clear-history-btn {
  padding: 8rpx 16rpx;
}

.clear-text {
  font-size: 24rpx;
  color: #999;
}

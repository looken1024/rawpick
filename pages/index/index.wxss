page {
  background: #f5f5f5;
}

.container {
  padding: 0 20rpx 20rpx;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #fff;
}

.nav-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 0 20rpx 0 20rpx;
  padding-right: calc(20rpx + env(safe-area-inset-right));
  height: 88rpx;
}

.nav-placeholder {
  width: 100%;
}

.share-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.share-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 20rpx;
  height: 64rpx;
  margin-left: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

/* 分类Tab */
.category-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.category-item.active {
  color: #333;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settings-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 下拉框遮罩 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 99;
}

/* 下拉框 */
.dropdown {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  padding: 30rpx;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.dropdown.show {
  transform: translateY(0);
}

.dropdown-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.ratio-list {
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ratio-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 8rpx;
  min-width: 100rpx;
}

.ratio-item.active {
  color: #fff;
  background: #07c160;
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 8rpx;
}

.dropdown-btns {
  display: flex;
  gap: 20rpx;
}

.dropdown-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.reset-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #07c160;
  color: #fff;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 10rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.waterfall-item {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.image-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #eee;
}

.waterfall-image {
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.waterfall-image.loaded {
  opacity: 1;
}

.image-loading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

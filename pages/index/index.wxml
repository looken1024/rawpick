<view class="container">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="height: {{statusBarHeight + 49}}px;">
    <view class="nav-content" style="top: {{statusBarHeight}}px;">
      <view class="share-btn" bindtap="onShareTap">
        <image class="share-icon" src="/icons/share.png" mode="aspectFit" />
      </view>
      <view class="search-bar" style="max-width: {{searchMaxWidth}};" bindtap="goToSearch">
        <text class="search-placeholder">搜索图片</text>
      </view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + 49}}px;"></view>

  <!-- 分类Tab + 设置图标 -->
  <view class="category-wrapper">
    <scroll-view class="category-scroll" scroll-x enable-flex>
      <view class="category-item {{currentCategoryId === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" data-id="{{index}}" bindtap="onCategoryTap">
        {{item}}
      </view>
    </scroll-view>
    <view class="settings-btn" bindtap="onSettingsTap">
      <image class="settings-icon" src="/images/more.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 比例选择下拉框 -->
  <view class="dropdown-mask" wx:if="{{showDropdown}}" bindtap="onMaskTap"></view>
  <view class="dropdown {{showDropdown ? 'show' : ''}}">
    <view class="dropdown-title">选择图片比例</view>
    <view class="ratio-list">
      <view class="ratio-item {{selectedRatio === item.value ? 'active' : ''}}" wx:for="{{ratioOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onRatioTap">
        <text>{{item.label}}</text>
        <view class="check-icon" wx:if="{{selectedRatio === item.value}}">✓</view>
      </view>
    </view>
    <view class="dropdown-btns">
      <view class="dropdown-btn reset-btn" bindtap="onRatioReset">重置</view>
      <view class="dropdown-btn confirm-btn" bindtap="onRatioConfirm">确定</view>
    </view>
  </view>

  <!-- 瀑布流图片列表 -->
  <view class="waterfall">
    <!-- 左列 -->
    <view class="waterfall-column">
      <view class="waterfall-item" wx:for="{{leftColumn}}" wx:key="_id">
        <view class="image-wrapper" style="height: {{item.displayHeight}}px;">
          <image 
            class="waterfall-image {{imageLoaded[item._id] ? 'loaded' : ''}}" 
            src="{{item.thumbnailFileID}}" 
            mode="aspectFill" 
            lazy-load 
            data-id="{{item._id}}" 
            data-thumbnailfileid="{{item.thumbnailFileID}}" 
            data-originalfileid="{{item.originalFileID}}" 
            data-title="{{item.title}}" 
            data-width="{{item.width}}" 
            data-height="{{item.height}}" 
            data-openid="{{item._openid}}" 
            bindload="onImageLoad" 
            bindtap="onImageTap"
            bindlongpress="onImageLongPress"
          />
          <view class="image-loading" wx:if="{{!imageLoaded[item._id]}}"></view>
        </view>
      </view>
    </view>

    <!-- 右列 -->
    <view class="waterfall-column">
      <view class="waterfall-item" wx:for="{{rightColumn}}" wx:key="_id">
        <view class="image-wrapper" style="height: {{item.displayHeight}}px;">
          <image 
            class="waterfall-image {{imageLoaded[item._id] ? 'loaded' : ''}}" 
            src="{{item.thumbnailFileID}}" 
            mode="aspectFill" 
            lazy-load 
            data-id="{{item._id}}" 
            data-thumbnailfileid="{{item.thumbnailFileID}}" 
            data-originalfileid="{{item.originalFileID}}" 
            data-title="{{item.title}}" 
            data-width="{{item.width}}" 
            data-height="{{item.height}}" 
            data-openid="{{item._openid}}" 
            bindload="onImageLoad" 
            bindtap="onImageTap"
            bindlongpress="onImageLongPress"
          />
          <view class="image-loading" wx:if="{{!imageLoaded[item._id]}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="loading-tip" wx:elif="{{!hasMore && images.length > 0}}">没有更多了</view>
  <view class="loading-tip" wx:elif="{{images.length === 0 && !loading}}">暂无图片</view>
</view>

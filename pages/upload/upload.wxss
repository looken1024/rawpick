page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 图片选择区 */
.upload-area {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.preview-section {
  position: relative;
}

.preview-swiper {
  width: 100%;
  height: 700rpx;
}

.preview-frame {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.preview-image {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.image-id-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.image-id {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  margin-right: 16rpx;
}

.remove-current {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  z-index: 10;
}

.re-select {
  text-align: center;
  font-size: 26rpx;
  color: #1296db;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.upload-placeholder {
  height: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 80rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 图片信息 */
.info-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

/* 表单 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-hint {
  padding: 16rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  background: #fafafa;
}

.form-item-column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #333;
}

.category-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.category-chip {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  border: 2rpx solid #eee;
}

.category-chip.active {
  color: #fff;
  background: #1296db;
  border-color: #1296db;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
}

.picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.picker-text.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 提交按钮 */
.submit-section {
  padding: 0 20rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  color: #fff;
  background: #07c160;
  border-radius: 48rpx;
}

.submit-btn.disabled {
  background: #ccc;
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 400px;
  height: 400px;
}

/* 上传结果面板 */
.result-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.copy-btn {
  flex-shrink: 0;
  padding: 8rpx 28rpx;
  background: #1296db;
  color: #fff;
  font-size: 26rpx;
  border-radius: 28rpx;
}

.result-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.copy-all {
  font-size: 26rpx;
  color: #1296db;
  padding: 0 10rpx;
}

.done-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: #07c160;
  border-radius: 44rpx;
}

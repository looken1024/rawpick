page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 图片选择区 */
.image-section {
  margin-bottom: 30rpx;
}

.image-wrapper {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.preview-image {
  width: 100%;
  height: 500rpx;
}

/* 滤镜效果 */
.filter-grayscale {
  filter: grayscale(100%);
}

.filter-sepia {
  filter: sepia(80%);
}

.filter-blur {
  filter: blur(3px);
}

.filter-brightness {
  filter: brightness(130%);
}

.filter-contrast {
  filter: contrast(150%);
}

.filter-saturate {
  filter: saturate(200%);
}

.filter-hue {
  filter: hue-rotate(90deg);
}

.filter-invert {
  filter: invert(100%);
}

.image-placeholder {
  width: 100%;
  height: 500rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.placeholder-icon {
  font-size: 80rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
}

/* 操作按钮 */
.action-section {
  margin-bottom: 30rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.primary-btn {
  background: #1296db;
}

.primary-btn .btn-text {
  color: #fff;
}

.btn-text {
  font-size: 28rpx;
  color: #333;
}

/* 滤镜选择 */
.filter-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 20rpx;
}

.filter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.filter-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
  border: 4rpx solid transparent;
}

.filter-item.active .filter-preview {
  border-color: #1296db;
}

.filter-color {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.filter-grayscale .filter-color {
  filter: grayscale(100%);
}

.filter-sepia .filter-color {
  filter: sepia(80%);
}

.filter-blur .filter-color {
  filter: blur(2px);
}

.filter-brightness .filter-color {
  filter: brightness(130%);
}

.filter-contrast .filter-color {
  filter: contrast(150%);
}

.filter-saturate .filter-color {
  filter: saturate(200%);
}

.filter-hue .filter-color {
  filter: hue-rotate(90deg);
}

.filter-invert .filter-color {
  filter: invert(100%);
}

.filter-name {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

/* 形状选择 */
.shape-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.shape-list {
  display: flex;
  gap: 30rpx;
}

.shape-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.shape-preview {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-bottom: 10rpx;
  border: 4rpx solid transparent;
}

.shape-item.active .shape-preview {
  border-color: #1296db;
}

.rect-shape {
  border-radius: 8rpx;
}

.circle-shape {
  border-radius: 50%;
}

.shape-name {
  font-size: 22rpx;
  color: #666;
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 400px;
  height: 400px;
}

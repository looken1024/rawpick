<view class="container">
  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="user-info">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{userInfo.avatarUrl || '/icons/head.png'}}" />
      </view>
      <view class="user-detail">
        <text class="nickname-text" wx:if="{{isLoggedIn}}">{{userInfo.nickName || '微信用户'}}</text>
        <text class="nickname-text placeholder" wx:else>未登录</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-section" wx:if="{{isLoggedIn}}">
    <view class="stat-item">
      <text class="stat-value">{{userStats.points}}</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.uploadCount}}</text>
      <text class="stat-label">上传</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.approvedCount}}</text>
      <text class="stat-label">审核通过</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.downloadCount}}</text>
      <text class="stat-label">下载</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToUpload">
      <image class="menu-icon-img" src="/icons/upload.png" mode="aspectFit" />
      <text class="menu-text">上传图片</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToReview">
      <image class="menu-icon-img" src="/icons/review.png" mode="aspectFit" />
      <text class="menu-text">图片审核</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 登录/退出按钮 -->
  <view class="btn-section">
    <button class="login-btn" wx:if="{{!isLoggedIn}}" bindtap="login" loading="{{logining}}">{{logining ? '登录中...' : '微信登录'}}</button>
    <view class="logout-btn" wx:else bindtap="onLogout">退出登录</view>
  </view>
</view>
